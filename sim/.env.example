# Copy to sim/.env to override the simulator's defaults (docker compose reads it).
# ENGINE_IMAGE=trade-ngin:sim
# PG_IMAGE=postgres:16
# SIM_FLASK_ENV=development
# QT_CATCHUP_PORTFOLIOS=qt_conservative,qt_conservative_model
# QT_CATCHUP_ENABLED=1
# QT_EVENING_RUN=0
# A second simulator next to the first (its own containers, images, volumes and ports):
# SIM_PROJECT=algolens-sim2
# SIM_WEB_PORT=8081
# SIM_MAIL_PORT=8026
# SIM_SMTP_PORT=1026
# SIM_PG_PORT=55433
