# CORS_ORIGINS=https://algolens.algogators.com in production.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET_KEY=
CORS_ORIGINS=
FLASK_ENV=
FLASK_DEBUG=
PORT=
