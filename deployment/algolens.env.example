# AlgoLens backend environment. On the box this file is
# /home/ubuntu/.config/algogators/algolens.env (mode 600, never in git).
# Names only; the values are the ones the old host's backend container used.
# Set FLASK_ENV=production, FLASK_DEBUG=False and
# CORS_ORIGINS=https://algolens.algogators.com in production.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET_KEY=
CORS_ORIGINS=
FLASK_ENV=
FLASK_DEBUG=
PORT=
# QT desk (trade-ngin docs/design/qt-contract.md). Safe defaults: the desk UI
# and every desk endpoint stay off until QT_DESK_ENABLED=true (ruling 22).
# The backend reaches the engine's gRPC server (trade-ngin `engine-rpc`, the
# desk is one of its services) over the shared docker network `qt`; a failed
# call never fails the user's action (the engine re-drives). DESK_AGENT_ADDR,
# the old name, is still read when ENGINE_RPC_ADDR is unset (one release).
ENGINE_RPC_ADDR=engine-rpc:50051
QT_DESK_ENABLED=false
# Who may decide an override request (either one; never the requester).
QT_APPROVERS=vp=<email>,president=<email>
