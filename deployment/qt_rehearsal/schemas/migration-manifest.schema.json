{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qt-rehearsal-migration-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "target_database", "entries"],
  "properties": {
    "schema_version": {"const": "qt-rehearsal-migration-manifest/v1"},
    "profile": {"enum": ["live-futures", "destructive-fixture"]},
    "target_database": {"enum": ["qt_rehearsal_migrated", "qt_rehearsal_destructive_tests"]},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "git_sha", "path", "sha256", "depends_on", "apply_predicate", "rollback_policy", "expected_schema_digest"]
      }
    }
  }
}
